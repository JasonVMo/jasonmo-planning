{
  "name": "jasonmo-planning",
  "private": true,
  "workspaces": [
    "packages/*",
    "scripts",
    "site"
  ],
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build",
    "bundle": "nx run site:bundle",
    "dev": "nx run site:dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "nx": "23.1.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2"
  },
  "packageManager": "yarn@4.18.0",
  "dependencies": {
    "docs": "^0.4.0"
  }
}
